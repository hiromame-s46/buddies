# Buddies専用設定
# このファイルを buddies/.env にコピーし、本番用の値へ変更してください。
# ../mail-system や ../todo の設定ファイルは読み込みません。

# アプリ設定
# DB接続はbuddies/api.phpが../../../api/config.phpを読み込んで行います。
BUDDIES_TIMEZONE=Asia/Tokyo

# メール基本設定
BUDDIES_MAIL_ENABLED=1
BUDDIES_MAIL_SUBJECT_PREFIX="[Buddies]"
BUDDIES_MAIL_CONFIRM_EXPIRES_HOURS=24
BUDDIES_MAIL_TOKEN_SECRET=change-this-to-a-long-random-secret
BUDDIES_MAIL_FROM=hiromame.sakura@gmail.com
BUDDIES_MAIL_FROM_NAME=ひろまめ
BUDDIES_MAIL_REPLY_TO=hiromame.sakura@gmail.com
BUDDIES_MAIL_RETURN_PATH=

# メール本文・画面のURL
BUDDIES_MAIL_CONTACT_URL=https://buddies46.stars.ne.jp/satellite/form/
BUDDIES_MAIL_TERMS_URL=https://buddies46.stars.ne.jp/satellite/index.php?section=terms
BUDDIES_MAIL_PRIVACY_URL=https://buddies46.stars.ne.jp/satellite/index.php?section=privacy
BUDDIES_MAIL_VERIFY_URL=https://buddies46.stars.ne.jp/satellite/buddies/email-verify.php
BUDDIES_MAIL_RESET_URL=https://buddies46.stars.ne.jp/satellite/buddies/password-reset.php
BUDDIES_MAIL_SETTINGS_URL=https://buddies46.stars.ne.jp/satellite/buddies/account/
BUDDIES_CONTACT_URL=https://buddies46.stars.ne.jp/satellite/form/

# SMTP設定
BUDDIES_MAIL_DRIVER=smtp
BUDDIES_SMTP_HOST=smtp.gmail.com
BUDDIES_SMTP_PORT=587
BUDDIES_SMTP_SECURE=tls
BUDDIES_SMTP_USER=hiromame.sakura@gmail.com
BUDDIES_SMTP_PASS=your-app-password
